    "qa:visual": "node scripts/visual-check.mjs",
    "qa:live": "node scripts/live-generation-check.mjs",
    "qa:upload": "node scripts/upload-check.mjs",
    "qa:generated": "node scripts/generated-visual-check.mjs",
    "qa:exam": "node scripts/exam-check.mjs",
    "qa:exam-layout": "node scripts/exam-layout-check.mjs",
    "qa:exam-responsive": "node scripts/exam-responsive-check.mjs",
    "qa:exam-profile": "node scripts/exam-profile-check.mjs",
    "qa:math": "node scripts/math-render-check.mjs",
    "qa:linear-algebra": "node scripts/linear-algebra-check.mjs",
    "qa:linear-exam": "node scripts/generate-linear-exam.mjs",
    "qa:settings": "node scripts/settings-check.mjs"
  },
  "dependencies": {
    "@markmap/parse": "^1.1.1",
    "@markmap/render": "^1.1.1",
    "@markmap/view": "^1.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",

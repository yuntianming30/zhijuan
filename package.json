  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "katex": "$katex"
  }

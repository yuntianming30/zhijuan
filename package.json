{
  "name": "zhijuan",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI review workbench for STEM course materials.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuntianming30/zhijuan.git"
  },
  "homepage": "https://github.com/yuntianming30/zhijuan#readme",
  "bugs": {
    "url": "https://github.com/yuntianming30/zhijuan/issues"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node scripts/run-api.mjs",
